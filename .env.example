# ============================================
# LabTrack Environment Configuration
# ============================================
# Copy this file to .env and fill in real values:
#   cp .env.example .env
#
# NEVER commit the .env file to version control!
# ============================================

# --- Application ---
PROJECT_NAME="LabTrack"
VERSION="1.0.0"
API_V1_STR="/api/v1"

# --- Security ---
# Generate a strong secret key:  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=CHANGE_ME_GENERATE_A_STRONG_SECRET_KEY
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# --- Database (PostgreSQL) ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME_USE_A_STRONG_PASSWORD
POSTGRES_DB=labtrack
POSTGRES_PORT=5432
# POSTGRES_HOST is set automatically by docker-compose (= "db" service name)
# For local development without Docker, set: POSTGRES_SERVER=localhost

# --- CORS ---
# Comma-separated list of allowed origins
# For Docker deployment (same-origin via nginx proxy):
ALLOWED_ORIGINS=http://localhost:80,http://localhost:5173,http://127.0.0.1:5173
# For production, replace with your domain:
# ALLOWED_ORIGINS=https://labtrack.youruniversity.edu

# --- Frontend Build ---
# Used during Docker build to set the API base URL
# /api/v1 = relative URL routed through nginx proxy (recommended for Docker)
VITE_API_URL=/api/v1

# --- Initial admin (optional; created once, no demo data) ---
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_NAME="System Administrator"
BOOTSTRAP_ADMIN_PASSWORD=
# Password must have at least 12 characters. Remove it after successful bootstrap.
# Hosted PostgreSQL may instead use DATABASE_URL=postgresql://...?...sslmode=require
# DATABASE_URL=

# --- Gmail SMTP notification delivery ---
# Add these settings to backend/.env (Docker also loads that file).
# Enable after adding a Google App Password, not your normal Google password.
SMTP_ENABLED=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_NAME=LabTrack
SMTP_TIMEOUT_SECONDS=10
# Transport is smtp.gmail.com:587 with STARTTLS; see backend/MAIL_SETUP.md.
